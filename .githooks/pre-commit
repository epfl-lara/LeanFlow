#!/bin/sh
set -eu

case "${ALLOW_WORKFLOW_FIXTURE_COMMIT:-}" in
  1|true|TRUE|yes|YES|on|ON)
    exit 0
    ;;
esac

case "${ALLOW_PROVEDEMO_COMMIT:-}" in
  1|true|TRUE|yes|YES|on|ON)
    allow_provedemo=1
    ;;
  *)
    allow_provedemo=0
    ;;
esac

case "${ALLOW_LEANIMOBENCH_COMMIT:-}" in
  1|true|TRUE|yes|YES|on|ON)
    allow_leanimobench=1
    ;;
  *)
    allow_leanimobench=0
    ;;
esac

case "${ALLOW_DOCFORMALIZATIONDEMO_COMMIT:-}" in
  1|true|TRUE|yes|YES|on|ON)
    allow_docformalizationdemo=1
    ;;
  *)
    allow_docformalizationdemo=0
    ;;
esac

blocked=0

provedemo_paths="$(git diff --cached --name-only -- testdata/workflow_projects/ProveDemo)"
if [ -n "${provedemo_paths}" ] && [ "${allow_provedemo}" -ne 1 ]; then
  echo "Commit blocked: staged changes under testdata/workflow_projects/ProveDemo are protected." >&2
  echo "These files are kept as a canonical workflow fixture." >&2
  echo "Runtime attempts should stay in ignored paths such as .leanflow/ and .lake/." >&2
  echo "For an intentional fixture refresh, rerun with ALLOW_PROVEDEMO_COMMIT=1." >&2
  echo >&2
  printf '%s\n' "${provedemo_paths}" >&2
  blocked=1
fi

docformalizationdemo_paths="$(git diff --cached --name-only -- testdata/workflow_projects/DocFormalizationDemo)"
if [ -n "${docformalizationdemo_paths}" ] && [ "${allow_docformalizationdemo}" -ne 1 ]; then
  echo "Commit blocked: staged changes under testdata/workflow_projects/DocFormalizationDemo are protected." >&2
  echo "These files are kept as a canonical document-formalization workflow fixture." >&2
  echo "Runtime attempts should stay in ignored paths such as .leanflow/, .lake/, and LaTeX build outputs." >&2
  echo "For an intentional fixture refresh, rerun with ALLOW_DOCFORMALIZATIONDEMO_COMMIT=1." >&2
  echo >&2
  printf '%s\n' "${docformalizationdemo_paths}" >&2
  blocked=1
fi

# campaign-results/ holds exported measurements, never a problem statement.
# It is excluded so archiving a finished run does not need the statement-refresh
# override -- reaching for that variable routinely is how a real statement edit
# would eventually slip past this guard.
leanimobench_paths="$(git diff --cached --name-only \
  -- testdata/workflow_projects/LeanIMOBench \
  ':(exclude)testdata/workflow_projects/LeanIMOBench/campaign-results')"
if [ -n "${leanimobench_paths}" ] && [ "${allow_leanimobench}" -ne 1 ]; then
  echo "Commit blocked: staged changes under testdata/workflow_projects/LeanIMOBench are protected." >&2
  echo "The 60 problem statements are vendored verbatim from IMO-LeanProofBench; editing one" >&2
  echo "silently invalidates every score compared against the published baseline." >&2
  echo "Runs should write to ignored paths such as .leanflow/, .lake/, and results/." >&2
  echo "To refresh from upstream, use scripts/build_benchmark.py and rerun with ALLOW_LEANIMOBENCH_COMMIT=1." >&2
  echo >&2
  printf '%s\n' "${leanimobench_paths}" >&2
  blocked=1
fi

if [ "${blocked}" -ne 0 ]; then
  exit 1
fi

exit 0
