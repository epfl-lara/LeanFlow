#!/usr/bin/env python3
"""Reclaim .lake directories from settled, terminal benchmark cells."""

import argparse
import json
import os
import shutil
import time
from datetime import UTC, datetime
from pathlib import Path

RECLAIMABLE = {"completed", "budget_exhausted"}
SETTLE_S = 300


def owned_path(campaign_dir: Path, cell_id: str) -> Path:
    """Return a cell directory contained within the campaign, rejecting escapes."""
    if not cell_id or cell_id in {".", ".."} or Path(cell_id).name != cell_id:
        raise ValueError(f"Invalid cell id: {cell_id!r}")
    path = campaign_dir / "cells" / cell_id / ".lake"
    if not path.resolve().is_relative_to(campaign_dir.resolve()):
        raise ValueError(f"Cell path escapes campaign: {path}")
    return path


def in_use(path: Path, proc_root: Path = Path("/proc")) -> bool:
    """Protect directories held by a process or when process inspection fails."""
    target = str(path.resolve())
    try:
        processes = list(proc_root.iterdir())
    except OSError:
        return True
    for proc in processes:
        if not proc.name.isdigit():
            continue
        try:
            cwd = os.readlink(proc / "cwd")
            if cwd == target or cwd.startswith(target + "/"):
                return True
            for fd in (proc / "fd").iterdir():
                dest = os.readlink(fd)
                if dest == target or dest.startswith(target + "/"):
                    return True
        except OSError:
            # A vanished process is harmless; unreadable live state is not proof of safety.
            if proc.exists():
                return True
    return False


def free_gb(campaign_dir: Path) -> float:
    """Return free space on the campaign filesystem in GiB."""
    return shutil.disk_usage(campaign_dir).free / 1024**3


def sweep(campaign_dir: Path, apply: bool = False) -> int:
    """Reclaim only settled terminal cells, preserving proof and run evidence."""
    campaign = json.loads((campaign_dir / "campaign.json").read_text())
    paths = [(cell, owned_path(campaign_dir, cell["id"])) for cell in campaign["cells"]]
    done = 0
    for cell, lake in paths:
        status = cell.get("status")
        if not lake.is_dir() or status not in RECLAIMABLE or cell.get("resume_run_id"):
            continue
        if status == "completed" and not cell.get("verified"):
            continue
        finished = cell.get("finished_at")
        if not finished:
            continue
        age = (datetime.now(UTC) - datetime.fromisoformat(finished)).total_seconds()
        if age < SETTLE_S:
            print(f"  {cell['id']}: finished {int(age)}s ago, waiting for settle", flush=True)
            continue
        if in_use(lake):
            print(f"  {cell['id']}: live or uninspectable process state, skipping", flush=True)
            continue
        size = sum(f.stat().st_size for f in lake.rglob("*") if f.is_file()) / 1024**3
        print(f"  {cell['id']}: {status}, .lake={size:.1f} GiB -> reclaim", flush=True)
        if apply:
            shutil.rmtree(lake)
        done += 1
    return done


def main(argv: list[str] | None = None) -> int:
    """Run one dry-run sweep or an explicitly requested reclamation loop."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--campaign-dir", default=os.environ.get("LEANFLOW_CAMPAIGN_DIR"))
    parser.add_argument("--apply", action="store_true", help="Delete eligible .lake directories")
    parser.add_argument("--loop", type=int, default=0, metavar="SECONDS")
    args = parser.parse_args(argv)
    if not args.campaign_dir:
        parser.error("set --campaign-dir or LEANFLOW_CAMPAIGN_DIR")
    if args.loop < 0:
        parser.error("--loop must be nonnegative")
    campaign_dir = Path(args.campaign_dir).expanduser().resolve()
    while True:
        campaign = json.loads((campaign_dir / "campaign.json").read_text())
        live = [c["id"] for c in campaign["cells"] if c.get("status") in {"preparing", "running"}]
        print(
            f"[{time.strftime('%H:%M:%S')}] free={free_gb(campaign_dir):.0f} GiB  live={live or 'none'}",
            flush=True,
        )
        count = sweep(campaign_dir, args.apply)
        print(f"  {'reclaimed' if args.apply else 'would reclaim'} {count}", flush=True)
        if not args.loop:
            return 0
        time.sleep(args.loop)


if __name__ == "__main__":
    raise SystemExit(main())
